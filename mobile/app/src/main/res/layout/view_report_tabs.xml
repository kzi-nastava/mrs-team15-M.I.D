<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_chart_area"
    android:orientation="vertical"
    android:padding="8dp">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/reportTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabIndicatorColor="#D32F2F"
        app:tabSelectedTextColor="#D32F2F"
        app:tabTextColor="#6c757d">

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tabRides"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rides" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tabDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distance" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tabExpense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Money" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Rides pane -->
    <LinearLayout
        android:id="@+id/paneRides"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRidesSum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sum: -" />

            <TextView
                android:id="@+id/tvRidesAvg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Avg: -" />

        </LinearLayout>

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/ridesChart"
            android:layout_width="match_parent"
            android:layout_height="280dp" />

    </LinearLayout>

    <!-- Distance pane -->
    <LinearLayout
        android:id="@+id/paneDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvKmSum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sum (km): -" />

            <TextView
                android:id="@+id/tvKmAvg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Avg (km): -" />

        </LinearLayout>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/distanceChart"
            android:layout_width="match_parent"
            android:layout_height="280dp" />

    </LinearLayout>

    <!-- Expense/Money pane -->
    <LinearLayout
        android:id="@+id/paneExpense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMoneySum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sum (RSD): -" />

            <TextView
                android:id="@+id/tvMoneyAvg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Avg (RSD): -" />

        </LinearLayout>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/expenseChart"
            android:layout_width="match_parent"
            android:layout_height="280dp" />

    </LinearLayout>

</LinearLayout>
